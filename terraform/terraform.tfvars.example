# Copy to terraform.tfvars (git-ignored) if you prefer not to pass -var on the CLI.
# The Makefile passes ssh_public_key automatically from ~/.ssh/id_ed25519.pub.

ssh_public_key = "ssh-ed25519 AAAA... you@host"

# Optional overrides (defaults shown):
# node_image    = "24.04"
# server_count  = 1
# server_cpus   = 2
# server_memory = "2GiB"
# server_disk   = "12GiB"
# agent_count   = 2
# agent_cpus    = 2
# agent_memory  = "2GiB"
# agent_disk    = "12GiB"
